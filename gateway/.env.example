GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8100
# sqlite 便于本地；生产可改为 mysql+pymysql://user:pass@host:3306/ai_test
DATABASE_URL=sqlite:///./data/ai_test.db
API_KEY=dev-key
ENGINE_DEFAULT_URL=http://127.0.0.1:8200

# mvp | milvus  （milvus 不可用时自动回退 mvp）
VECTOR_STORE=mvp
VECTOR_DATA_DIR=./data/vector
RAG_TOP_K=5

# Milvus Lite 本地文件，或 http://127.0.0.1:19530
MILVUS_URI=./data/milvus_rag.db

# 可选：OpenAI 兼容 embedding；留空则用本地哈希向量（便于联调 Milvus）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
